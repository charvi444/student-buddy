{
  "manifest_version": 3,
  "name": "Student Buddy",
  "version": "1.0.1",
  "description": "To-do lists, notes, and motivational quotes — all without leaving your tab.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://quoteslate.vercel.app/*",
    "https://zenquotes.io/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
